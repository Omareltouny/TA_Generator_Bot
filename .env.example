TELEGRAM_BOT_TOKEN=
INVITE_TOKEN=change-me
OWNER_TELEGRAM_ID=
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# polling | webhook
UPDATE_MODE=polling
WEBHOOK_URL=
PORT=8080
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Comma-separated provider order and per-provider model lists
LLM_PROVIDER_ORDER=gemini,groq,openrouter
GROQ_MODELS=llama-3.3-70b-versatile
GEMINI_MODELS=gemini-2.0-flash
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
MAX_FILE_MB=20
MAX_TOTAL_MATERIAL_MB=60
